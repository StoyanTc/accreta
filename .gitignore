# ==========================================
# Rust & Cargo Build Artifacts
# ==========================================
# Ignores the shared Rust compilation directory at the workspace root
/target/

# ==========================================
# WebAssembly & Wasm-Pack Output
# ==========================================
# Ignores the 'pkg/' output folders generated by wasm-pack in any sub-project
**/pkg/
# Ignores the log files generated by wasm-pack if a build crashes
wasm-pack-init.log
# Ignores the hidden tool cache folder used internally by wasm-pack (Added)
/.wasm-pack/


# ==========================================
# JavaScript / Node.js Addons & Libraries
# ==========================================
# Ignores installed npm dependencies
node_modules/
# Ignores native C++ or N-API compiled binary addons
*.node
# Ignores the native binaries built inside npm subdirectories
npm/*/*.node
# Ignores generated JavaScript entry points and TypeScript type definitions
index.js
index.d.ts

# ==========================================
# C/C++ Interop Build Folders
# ==========================================
# Ignores generated include headers for C bindings
**/include/
# Ignores build artifacts for the C examples project
**/examples/c/build/

# ==========================================
# Python Virtual Environments & Cache
# ==========================================
# Ignores local Python virtual environments
.venv/
# Ignores compiled Python bytecode directories and files
__pycache__/
*.pyc

# ==========================================
# IDEs & System Files
# ==========================================
# Ignores JetBrains IntelliJ/CLion project configurations
.idea/
# Ignores VS Code workspace configurations
.vscode/
# Ignores Vim/Neovim temporary swap files
*.swp
# Ignores macOS system thumbnail and folder layout caches
.DS_Store
